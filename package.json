{
  "name": "word-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.ts",
    "validate:content": "node scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/validate-content.ts && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
